# data safety: synthetic or real. Real forbids any hosted LLM provider.
DATA_MODE=synthetic

# LLM layer
# fake (canned outputs), ollama, openai_compat or hosted. Fake is the default and the demo fallback.
# For the local model: LLM_PROVIDER=ollama and LLM_MODEL=qwen3.5:4b (decision C5)
LLM_PROVIDER=fake
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_EMBED_MODEL=
# Only for a server that wants a key. Never needed for Ollama on this machine.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2
# The same prompt then gives the same answer, which makes a run easier to debug. Empty for random.
LLM_SEED=7
LLM_MAX_TOKENS=1500
# "none" switches thinking off. Thinking models such as qwen3.5 can spend the whole budget
# reasoning and return nothing. Leave empty for a server or model that does not take the field.
LLM_REASONING_EFFORT=none
ALLOW_HOSTED_LLM=false
# University servers that count as local for real data, comma separated (decision D17)
LLM_LOCAL_HOSTS=

# storage
DATABASE_URL=postgresql+psycopg://edss:edss@localhost:5432/edss

# connector
MCP_CONNECTOR_URL=http://localhost:8765/mcp
MCP_CONNECTOR_TOKEN=

# auth
# Signs session cookies. Required when DATA_MODE=real. In synthetic mode a throwaway one is used.
JWT_SECRET=
SESSION_HOURS=8
# Set true when served over HTTPS
COOKIE_SECURE=false
# One shared password for the synthetic seed users. Leave empty and only demo sign-in works.
EDSS_SEED_PASSWORD=
# One-click role switcher on the login page. Ignored unless DATA_MODE=synthetic.
EDSS_DEMO_LOGIN=false

# pipeline behaviour
MAX_ATTEMPTS=3
STALE_AFTER_DAYS=90
# a run that takes longer than this is stopped
RUN_BUDGET_SECONDS=300
# demo only: milliseconds each domain agent waits on its source, so parallel work is visible
SOURCE_LATENCY_MS=0

# never send run data to external tracing
LANGCHAIN_TRACING_V2=false
