# data safety: synthetic or real. Real forbids any hosted LLM provider.
DATA_MODE=synthetic

# LLM layer
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_EMBED_MODEL=
ALLOW_HOSTED_LLM=false

# storage
DATABASE_URL=postgresql+psycopg://edss:edss@localhost:5432/edss

# connector
MCP_CONNECTOR_URL=http://localhost:8765/mcp
MCP_CONNECTOR_TOKEN=

# auth
JWT_SECRET=

# pipeline behaviour
MAX_ATTEMPTS=3
STALE_AFTER_DAYS=90

# never send run data to external tracing
LANGCHAIN_TRACING_V2=false
