{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "backend",
        "uvicorn",
        "app.main:create_app",
        "--factory",
        "--reload",
        "--reload-dir",
        "backend/app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "demo",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "scripts/demo.sh"
      ],
      "port": 3000
    },
    {
      "name": "demo-live",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "LLM_PROVIDER=ollama",
        "LLM_MODEL=qwen3.5:4b",
        "bash",
        "scripts/demo.sh"
      ],
      "port": 3000
    }
  ]
}
